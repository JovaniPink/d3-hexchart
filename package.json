{
  "name": "d3-nba-hex-chart",
  "version": "0.1.0",
  "keywords": [
    "react",
    "xstate",
    "file-drag-&-drop",
    "file-uploader"
  ],
  "description": "Playing with React, D3, Hex Charts and NBA data.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "d3": "7.9.0",
    "d3-hexbin": "0.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:generate": "node scripts/generate-hexes.mjs",
    "data:check": "node scripts/generate-hexes.mjs --check",
    "test": "vitest run",
    "check": "npm run data:check && npm test && npm run build",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "audit:dependencies": "npm audit --audit-level=low",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/d3": "7.4.3",
    "@types/d3-hexbin": "0.2.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
