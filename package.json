{
  "name": "d3-nba-hex-chart",
  "version": "0.1.0",
  "keywords": [
    "accessibility",
    "basketball",
    "d3",
    "d3-hexbin",
    "data-visualization",
    "nba",
    "react",
    "shot-chart",
    "typescript",
    "vite"
  ],
  "description": "Interactive, keyboard-accessible NBA hexbin shot chart backed by a deterministic Ja Morant 2019-20 snapshot.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "fsevents": false
  },
  "dependencies": {
    "d3": "7.9.0",
    "d3-hexbin": "0.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:generate": "node scripts/generate-hexes.mjs",
    "data:check": "node scripts/generate-hexes.mjs --check",
    "package:check": "node scripts/check-package-contract.mjs",
    "test": "vitest run",
    "check": "npm run package:check && npm run data:check && npm test && npm run build",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "audit:dependencies": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/d3": "7.4.3",
    "@types/d3-hexbin": "0.2.5",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
